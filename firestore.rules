rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isMember(memberUids) {
      return isSignedIn() && request.auth.uid in memberUids;
    }

    // get() på parent-trippen bruges KUN i create/update-regler (enkelt-
    // dokument-skrivninger) — aldrig i read-regler, da det får list-queries
    // til at fejle. Se CLAUDE.md.
    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isTripMember(tripId) {
      return isSignedIn() && request.auth.uid in tripData(tripId).memberUids;
    }

    function isTripOwner(tripId) {
      return isSignedIn() && request.auth.uid == tripData(tripId).ownerUid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Brugerprofiler (uid + email) — bruges til at slå en e-mail op til et
    // uid, når man tilføjer en ven. Alle loggede ind brugere må læse (kun
    // uid+email, ikke følsomt), men man må kun skrive sit eget dokument.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);

      match /friends/{friendUid} {
        allow read, write: if isOwner(uid);
      }
    }

    match /trips/{tripId} {
      allow read: if isMember(resource.data.memberUids);
      allow create: if isOwner(request.resource.data.ownerUid)
        && request.resource.data.memberUids == [request.auth.uid];
      // Alle medlemmer må redigere rejsens indhold, men kun ejeren må ændre
      // hvem der er medlem, delings-kategorier, eller slette rejsen.
      allow update: if isMember(resource.data.memberUids)
        && (isOwner(resource.data.ownerUid)
          || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['ownerUid', 'memberUids', 'sharedCategories']));
      allow delete: if isOwner(resource.data.ownerUid);

      // Subcollection-dokumenter har selv et denormaliseret memberUids-felt,
      // så reglen kan matche direkte uden get() på parent — get() i en regel
      // der også skal understøtte list/query-kald på subcollectionen fejler
      // i praksis for query-requests. Se CLAUDE.md.
      match /days/{dayId} {
        allow read, update, delete: if isMember(resource.data.memberUids);
        allow create: if isMember(request.resource.data.memberUids);

        match /segments/{segmentId} {
          allow read, update, delete: if isMember(resource.data.memberUids);
          allow create: if isMember(request.resource.data.memberUids);
        }
      }

      // Billeder og sporingspunkter har hver deres eget adgangsfelt
      // (photoViewerUids / trackViewerUids) i stedet for memberUids — styret
      // af trippens sharedCategories og indeholder altid mindst trippens ejer
      // og den der oprettede dokumentet. Se computeViewerUids i
      // src/shared/utils og CLAUDE.md. Trippens ejer må opdatere selve
      // adgangsfeltet på andres dokumenter (cascade ved ændret deling).
      match /photos/{photoId} {
        allow read: if isMember(resource.data.photoViewerUids);
        allow create: if isMember(request.resource.data.photoViewerUids)
          && request.resource.data.ownerUid == request.auth.uid
          && isTripMember(tripId);
        allow update: if isOwner(resource.data.ownerUid)
          || (isTripOwner(tripId) && onlyChanges(['photoViewerUids']));
        allow delete: if isOwner(resource.data.ownerUid);
      }

      match /track/{pointId} {
        allow read: if isMember(resource.data.trackViewerUids);
        allow create: if isMember(request.resource.data.trackViewerUids)
          && request.resource.data.ownerUid == request.auth.uid
          && isTripMember(tripId);
        allow update: if isOwner(resource.data.ownerUid)
          || (isTripOwner(tripId) && onlyChanges(['trackViewerUids']));
        allow delete: if isOwner(resource.data.ownerUid);
      }
    }
  }
}
